{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simgames/contract/v1/topology",
  "title": "Topology document (POST /gb/net/reset body)",
  "type": "object",
  "required": ["contract", "network_kind", "name", "steps_per_day", "native", "zones", "devices"],
  "properties": {
    "contract": {"const": "1.0"},
    "network_kind": {"enum": ["power", "heat", "water"]},
    "name": {"type": "string", "minLength": 1},
    "steps_per_day": {"type": "integer", "minimum": 24, "maximum": 1440},
    "native": {
      "type": "object",
      "description": "Backend-family-specific network description, verbatim (power: netzsim five-doc GridInputs; heat: rtheatflow five-file bundle). Profile arrays must have exactly steps_per_day entries."
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "node": {"type": "string", "description": "power/water: node reference in native"},
          "consumer": {"type": "string", "description": "heat: consumer name in native"}
        }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["slack", "generator", "pv", "wind", "coupling_load",
                            "chp", "heat_pump", "boiler", "battery", "storage_heat"]},
          "node": {"type": "string"},
          "params": {"type": "object"}
        }
      }
    }
  }
}
